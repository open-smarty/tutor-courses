{
  "id": "bdat-608",
  "title": "BDAT 608: Computational Statistics in Big Data II",
  "description": "The complete statistical modelling workflow in R: defining model families, fitting with OLS and custom loss functions, visualising predictions and residuals, writing R formulas for interactions and splines, handling missing data, and extending to GLMs, robust regression, GAMs, penalised regression, and decision trees. Anchored by two real-data case studies using diamonds and nycflights13.",
  "author": "Richard Minkah, PhD and E. Somua-Wiafe, PhD — Department of Statistics & Actuarial Science, University of Ghana, Legon",
  "version": "1.0.0",
  "subject": "Computational Statistics / R",
  "level": "intermediate",
  "estimatedHours": 8,
