{
  "id": "bdat-624",
  "title": "Biostatistical Processes and Analytics",
  "description": "An MSc-level course covering stochastic processes (Markov chains, branching processes, Poisson, birth-death) and survival analysis (Kaplan-Meier, Cox PH, AFT, competing risks). Rigorous derivations with accessible notation and R-based exercises using real biostatistics datasets.",
  "author": "Prof. Louis Asiedu",
  "version": "1.0.0",
  "subject": "biostatistics",
  "level": "advanced",
  "estimatedHours": 38,
  "prerequisites": [
    "Calculus: differentiation, integration, first-order ODEs",
    "Probability: random variables, expectation, variance, conditional probability",
    "Distributions: Binomial, Poisson, Exponential, Gamma",
    "Introductory R (or willingness to learn from in-lesson walkthroughs)"
  ],
  "apiSubmission": {
    "enabled": false,
    "endpoint": "",
    "courseId": ""
  },
